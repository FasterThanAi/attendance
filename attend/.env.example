# Copy to .env and fill in. Never commit .env.
# See services/api/app/config.py for how these are read.

ENVIRONMENT=development

# Overridden to point at the "postgres"/"redis" service names when run via
# docker-compose (see docker-compose.yml) -- these values are for running
# api/worker directly on the host instead.
DATABASE_URL=postgresql+asyncpg://attend:attend@localhost:5432/attend
REDIS_URL=redis://localhost:6379/0

# Object storage (S3-compatible). For local dev, run MinIO alongside this
# stack and point these at it; in production point at Supabase Storage or
# real S3 / DigitalOcean Spaces.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=attend-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Shared volume where pipeline stages write per-job artifacts.
JOB_DATA_DIR=/data/jobs

# Biometric data retention window (days) -- see docs/DATA_PROTECTION.md (Phase 9).
BIOMETRIC_RETENTION_DAYS=180
