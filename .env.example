# Attend — environment variables (Phase 0 config.py contract)
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# ===== ENVIRONMENT =====
ENVIRONMENT=development          # development | staging | production

# ===== DATABASE (Postgres) =====
# Local Mac dev (docker-compose postgres service):
DATABASE_URL=postgresql+asyncpg://attend:attend@localhost:5432/attend
# Later, when you move to Supabase Postgres, swap in the connection string
# from Supabase Project Settings > Database > Connection string (URI, "Session" mode).
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=              # server-side only, never in frontend
# SUPABASE_ANON_KEY=                      # safe for frontend, RLS-restricted

# ===== JOB QUEUE (Redis + RQ) =====
REDIS_URL=redis://localhost:6379/0

# ===== OBJECT STORAGE (S3-compatible) =====
# Local Mac dev: run MinIO via docker-compose instead of paying for S3/Supabase Storage.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=attend-media
S3_ACCESS_KEY=                    # MinIO root user, or Supabase Storage access key
S3_SECRET_KEY=                    # MinIO root password, or Supabase Storage secret
# Generate a MinIO dev credential pair with:
#   openssl rand -hex 16   (for access key)
#   openssl rand -hex 32   (for secret key)

# ===== FILE / JOB STORAGE (local disk, mounted volume) =====
JOB_DATA_DIR=/data/jobs            # shared volume between api and worker containers

# ===== BIOMETRIC DATA RETENTION =====
BIOMETRIC_RETENTION_DAYS=180       # gallery_embedding / detected_cluster TTL

# ===== AUTH / SECURITY (not explicit in the roadmap doc, but required for
# Phase 0 "teacher" table which has password_hash, and Phase 8 sign-in screen) =====
JWT_SECRET_KEY=                    # generate: openssl rand -hex 32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ===== ML MODELS (InsightFace) =====
# insightface downloads buffalo_l (ArcFace r100) and det_10g (SCRFD) on first run.
# Pin a cache dir so Docker builds can bake the models in (Phase 9 deployment rule).
INSIGHTFACE_HOME=/opt/models/insightface

# ===== FRONTEND (Next.js, apps/web/.env.local) =====
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ===== DEPLOYMENT ONLY (Phase 9 — not needed for local Mac dev) =====
# POSTGRES_BACKUP_S3_BUCKET=
# TLS_DOMAIN=                      # for Caddy/nginx auto-TLS
# SENTRY_DSN=                      # optional, if you add error monitoring
